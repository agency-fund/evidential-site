{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evidential-www",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-01",
  // The Worker only runs for /api/* (form submissions), so volume is tiny: keep every log and trace.
  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1, "invocation_logs": true },
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  // The site is static; the Worker only runs for /api/* (the contact form). Everything else is served directly
  // from the built assets without invoking the Worker.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash",
    "run_worker_first": ["/api/*"],
  },
  // Production: only the www.evidential.dev custom domain, attached by the first `wrangler deploy` (`task www:launch`).
  // Previews go to a separate Worker, evidential-www-preview (`task www:deploy:preview` passes --worker-name), so the
  // token CI uses for them can't change production. They never take over routes and are served on
  // <preview-name>-evidential-www-preview.the-agency-fund.workers.dev, which Cloudflare marks noindex. The first
  // `wrangler preview` creates that Worker with the two settings below.
  "workers_dev": false,
  "preview_urls": true,
  "routes": [{ "pattern": "www.evidential.dev", "custom_domain": true }],
  "vars": {
    "DEPLOY_ENV": "production",
    "CONTACT_FROM": "website@evidential.dev",
  },
  // Workers may only send to Email Routing destination addresses verified on the account. support@evidential.dev is
  // verified as one; Email Routing then forwards it like any other mail to that address.
  "send_email": [{ "name": "CONTACT_EMAIL", "allowed_destination_addresses": ["support@evidential.dev"] }],
  "ratelimits": [{ "name": "CONTACT_RATE_LIMIT", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }],
  // Secrets, set with `wrangler secret put` and never committed. Listing them here generates their types and makes
  // `wrangler deploy` fail until each one is set. Add a SLACK_WEBHOOK_* entry for every Slack channel enabled in
  // worker/notifications.config.ts (the type checker enforces this).
  "secrets": { "required": ["TURNSTILE_SECRET"] },

  // Previews do not inherit any of the above. They have no email binding and the Worker skips all notifications
  // when DEPLOY_ENV isn't "production", so a Preview can never email or post to Slack. Turnstile uses Cloudflare's
  // test keys there, so no Preview secrets are needed.
  "previews": {
    "vars": {
      "DEPLOY_ENV": "preview",
      "CONTACT_FROM": "website@evidential.dev",
    },
    "ratelimits": [{ "name": "CONTACT_RATE_LIMIT", "namespace_id": "1002", "simple": { "limit": 5, "period": 60 } }],
  },
}
