---
import { Image } from "astro:assets";
import evidential from "../assets/logos/evidential.svg";
import Base from "../layouts/Base.astro";
import { SITE } from "../site";
---

<Base title="Page not found | Evidential">
  <main class="notfound">
    <a href="/" aria-label="Evidential — home">
      <Image src={evidential} alt="Evidential" loading="eager" />
    </a>
    <h1>Page not found</h1>
    <p>The page you're looking for doesn't exist or has moved.</p>
    <p class="actions">
      <a class="btn btn-primary" href="/">
        Go to the home page
      </a>
      <a class="btn btn-ghost" href={SITE.docsUrl}>
        Read the docs
      </a>
    </p>
  </main>
</Base>

<style>
  .notfound {
    min-height: 100vh;
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 8px;
    padding: 48px 24px;
    text-align: center;
  }
  .notfound img {
    height: 40px;
    margin-bottom: 32px;
  }
  .notfound p {
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }
</style>
