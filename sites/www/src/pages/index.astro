---
// Import the layout first: CSS is bundled in import order, and global styles must precede component styles.
import Base from "../layouts/Base.astro";
import heroWaves from "../assets/textures/waves.svg?url";
import ContactCta from "../components/ContactCta.astro";
import DemoBand from "../components/DemoBand.astro";
import Experiments from "../components/Experiments.astro";
import Features from "../components/Features.astro";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import HowSteps from "../components/HowSteps.astro";
import PartnerTests from "../components/PartnerTests.astro";
import PhotoBand from "../components/PhotoBand.astro";
import Readiness from "../components/Readiness.astro";
import Trust from "../components/Trust.astro";
import Why from "../components/Why.astro";
---

<Base>
  {/* The hero's wave texture is the largest paint on phones; fetch it before the stylesheet asks for it. */}
  <link slot="head" rel="preload" as="image" href={heroWaves} fetchpriority="high" />
  <Header />
  <main>
    <Hero />
    <Trust />
    <Experiments />
    <PhotoBand />
    <Why />
    <PartnerTests />
    <HowSteps />
    <DemoBand />
    <Features />
    <Readiness />
    <ContactCta />
  </main>
  <Footer />
</Base>
