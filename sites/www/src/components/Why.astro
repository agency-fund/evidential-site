---
import { Image } from "astro:assets";
import { ordered } from "../content/ordered";
import evidential from "../assets/logos/evidential.svg";
import { icons } from "../icons";

const points = await ordered("why");
const rows = await ordered("comparison");
---

<section id="why">
  <div class="wrap">
    <div class="why-top">
      <div class="why-head">
        <h2 class="why-title">Built for how nonprofits work</h2>
        <p class="sub">
          Plenty of tools can run an A/B test. Almost none are built to measure real program outcomes across the
          channels you deliver on.
        </p>
      </div>
      <div class="why-card">
        <ul class="why-list">
          {points.map(({ data }) => {
            const Icon = icons[data.icon];
            return (
              <li>
                <span class="wi" aria-hidden="true">
                  <Icon />
                </span>
                <strong>{data.title}</strong> {data.body}
              </li>
            );
          })}
        </ul>
      </div>
    </div>
    <h3 class="cmp-title" id="compare-title">
      How Evidential compares
    </h3>
    <table class="cmp" aria-labelledby="compare-title">
      <thead>
        <tr>
          <th scope="col">Category (examples)</th>
          <th scope="col">Built for</th>
          <th scope="col">Typically measures</th>
          <th scope="col">Assumes you have</th>
        </tr>
      </thead>
      <tbody>
        {rows.map(({ data }) => (
          <tr>
            <td>{data.category}</td>
            <td>{data.builtFor}</td>
            <td>{data.measures}</td>
            <td>{data.assumes}</td>
          </tr>
        ))}
        <tr class="us">
          <td>
            <Image class="cmp-logo" src={evidential} alt="Evidential" />
          </td>
          <td>Nonprofits improving live programs</td>
          <td>Engagement, behavior change &amp; outcomes</td>
          <td>An appetite to experiment</td>
        </tr>
      </tbody>
    </table>
  </div>
</section>

<style>
  table.cmp {
    width: 100%;
    border-collapse: collapse;
    font-size: 13px;
    margin-top: 34px;
    border: 1px solid var(--border-subtle);
    border-radius: 12px;
    overflow: hidden;
  }
  table.cmp th {
    background: var(--navy-600);
    color: #fff;
    text-align: left;
    padding: 11px 14px;
    font-weight: 600;
    font-size: 12.5px;
  }
  table.cmp td {
    padding: 11px 14px;
    border-top: 1px solid var(--border-subtle);
    color: var(--grey-600);
  }
  table.cmp tr.us td {
    background: var(--navy-50);
    color: var(--navy-900);
    font-weight: 600;
  }
  .why-head {
    max-width: 720px;
  }
  .why-head .sub {
    margin-top: 12px;
    font-size: 17px;
    line-height: 1.55;
  }
  .why-card {
    margin-top: 36px;
    background: var(--grey-50);
    border: 1px solid var(--border-subtle);
    border-radius: 16px;
    padding: 34px 40px;
  }
  .why-list {
    list-style: none;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px 40px;
  }
  .why-list li {
    position: relative;
    padding-left: 30px;
    font-size: 16px;
    color: var(--grey-700);
    line-height: 1.55;
  }
  .why-list li::before {
    content: "";
    position: absolute;
    left: 4px;
    top: 0.5em;
    width: 9px;
    height: 9px;
    background: var(--gold-500);
    transform: rotate(45deg);
  }
  .why-list strong {
    color: var(--navy-600);
  }
  #why table.cmp {
    margin-top: 12px;
  }
  @media (max-width: 900px) {
    .why-card {
      padding: 26px 22px;
    }
    .why-list {
      grid-template-columns: 1fr;
    }
  }
  .why-head .sub {
    font-size: 19px;
  }
  .why-list li {
    font-size: 18px;
    color: #000;
  }
  .why-list strong {
    color: #000;
  }
  table.cmp {
    font-size: 16px;
  }
  table.cmp th {
    font-size: 15px;
    padding: 13px 16px;
  }
  table.cmp td {
    color: #000;
    padding: 13px 16px;
  }
  table.cmp tr.us td {
    color: #000;
  }
  @media (max-width: 520px) {
    .why-title {
      font-size: 28px;
    }
  }
  .why-top {
    display: block;
  }
  #why .wrap {
    max-width: 1160px;
  }
  .why-top .why-head {
    max-width: none;
  }
  .why-head .sub {
    max-width: 820px;
  }
  .why-title {
    font-size: 46px;
    line-height: 1.1;
    letter-spacing: -0.025em;
  }
  .why-card {
    background: 0 0;
    border: 0;
    border-radius: 0;
    padding: 0;
    margin: 0;
  }
  .why-card {
    margin-top: 40px;
  }
  .why-list {
    grid-template-columns: repeat(4, 1fr);
    gap: 16px;
    margin: 0;
    padding: 0;
    width: 100%;
    box-sizing: border-box;
  }
  .why-list li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 24px 22px;
    border: 1px solid var(--grey-300);
    border-radius: 6px;
    background: #f6f7f8;
    font-size: 16px;
    line-height: 1.5;
  }
  .why-list li:first-child {
    border-top: 1px solid var(--grey-300);
  }
  .why-list li:last-child {
    border-bottom: 1px solid var(--grey-300);
  }
  .why-list li::before {
    display: none;
  }
  .wi {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 6px;
    background: var(--navy-600);
    color: #fff;
    margin-bottom: 12px;
  }
  .wi svg {
    width: 24px;
    height: 24px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .why-list strong {
    display: block;
    font-size: 19px;
    line-height: 1.25;
    letter-spacing: -0.01em;
    margin-bottom: 2px;
  }
  .cmp-title {
    margin: 64px 0 20px;
    font-size: 32px;
    line-height: 1.15;
    letter-spacing: -0.02em;
    color: #000;
  }
  table.cmp td {
    background: #fff;
  }
  #why table.cmp {
    margin-top: 0;
    background: #fff;
    border-radius: 6px;
    box-shadow:
      0 20px 40px -16px rgba(0, 15, 26, 0.25),
      0 6px 16px rgba(0, 15, 26, 0.1);
  }
  .cmp-logo {
    display: block;
    height: 40px;
    width: auto;
  }
  @media (max-width: 900px) {
    .why-top {
      grid-template-columns: 1fr;
      gap: 24px;
    }
    .why-list {
      grid-template-columns: 1fr 1fr;
    }
    .why-title {
      font-size: 32px;
    }
  }
  .why-head .sub {
    font-size: 20px;
    line-height: 1.6;
  }
  .why-list li {
    font-size: 17px;
    line-height: 1.6;
  }
  table.cmp {
    font-size: 17px;
  }
  table.cmp th {
    font-size: 16px;
  }
  .why-head,
  .cmp-title {
    text-align: center;
  }
  @media (max-width: 640px) {
    table.cmp {
      table-layout: fixed;
      width: 100%;
      font-size: 11.5px;
      line-height: 1.35;
    }
    table.cmp th {
      font-size: 11px;
      padding: 9px 6px;
    }
    table.cmp td {
      padding: 9px 6px;
    }
    table.cmp th,
    table.cmp td {
      overflow-wrap: anywhere;
      hyphens: auto;
    }
    .cmp-logo {
      height: 24px;
      max-width: 100%;
    }
    .cmp-title {
      font-size: 24px;
    }
    .why-list {
      grid-template-columns: minmax(0, 1fr);
    }
  }
  .why-head .sub {
    margin-left: auto !important;
    margin-right: auto !important;
  }
  @media (max-width: 640px) {
    .why-list li,
    .why-list li strong {
      text-align: center;
      align-items: center;
    }
  }
  @media (max-width: 780px) {
    .why-title {
      font-size: 25px;
    }
    .cmp-title {
      font-size: 22px;
    }
  }
</style>
