---
/**
 * Asks once for analytics consent and records the choice for Analytics.astro. The footer's "Cookie settings" button
 * reopens it. Only rendered when GTM is enabled.
 */
---

<div class="consent" role="region" aria-label="Cookie consent" hidden>
  <p>
    We use analytics cookies to understand how people find and use this site. Your data is never sold or used for
    advertising.
  </p>
  <div class="actions">
    <button type="button" class="btn btn-ghost" data-consent="denied">
      Decline
    </button>
    <button type="button" class="btn btn-primary" data-consent="granted">
      Accept
    </button>
  </div>
</div>

<script>
  const KEY = "ev-consent";
  const banner = document.querySelector<HTMLElement>(".consent");
  // The "Cookie settings" button that reopened the banner, if any; focus returns there once a choice is made.
  let opener: HTMLElement | null = null;

  function stored(): string | null {
    try {
      return localStorage.getItem(KEY);
    } catch {
      return null;
    }
  }

  /** Expires Google Analytics cookies, which GA sets on the widest domain it can (here, evidential.dev). */
  function clearAnalyticsCookies() {
    const labels = location.hostname.split(".");
    const domains = [undefined, ...labels.slice(0, -1).map((_, i) => labels.slice(i).join("."))];
    for (const cookie of document.cookie.split(";")) {
      const name = cookie.split("=")[0]!.trim();
      if (!name.startsWith("_ga") && name !== "_gid") continue;
      for (const domain of domains) {
        document.cookie = `${name}=; Max-Age=0; Path=/${domain ? `; Domain=${domain}` : ""}`;
      }
    }
  }

  function choose(choice: "granted" | "denied") {
    try {
      localStorage.setItem(KEY, choice);
    } catch {
      // Storage can be unavailable (private mode); the choice still applies to this page view.
    }
    window.gtag?.("consent", "update", { analytics_storage: choice });
    if (choice === "denied") clearAnalyticsCookies();
    banner!.hidden = true;
    opener?.focus();
    opener = null;
  }

  if (banner) {
    banner.querySelectorAll<HTMLButtonElement>("[data-consent]").forEach((button) => {
      button.addEventListener("click", () => choose(button.dataset.consent === "granted" ? "granted" : "denied"));
    });
    // The footer's "Cookie settings" button reopens the banner so a choice can be changed or withdrawn at any time.
    document.querySelectorAll<HTMLButtonElement>("[data-consent-open]").forEach((button) => {
      button.addEventListener("click", () => {
        opener = button;
        banner.hidden = false;
        banner.querySelector<HTMLButtonElement>("[data-consent]")?.focus();
      });
    });
    if (stored() === null) banner.hidden = false;
  }
</script>

<style>
  .consent {
    position: fixed;
    inset: auto 16px 16px;
    z-index: 100;
    max-width: 560px;
    margin-inline: auto;
    padding: 16px 20px;
    display: flex;
    gap: 16px;
    align-items: center;
    background: var(--white);
    border: 1px solid var(--border-subtle);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-lg);
    font-size: 14px;
    line-height: 1.5;
  }
  .consent[hidden] {
    display: none;
  }
  .consent p {
    margin: 0;
    color: var(--text-muted);
  }
  .actions {
    display: flex;
    gap: 8px;
    flex-shrink: 0;
  }
  @media (max-width: 520px) {
    .consent {
      flex-direction: column;
      align-items: stretch;
    }
    .actions .btn {
      flex: 1;
    }
  }
</style>
