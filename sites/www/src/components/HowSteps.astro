---
import { ordered } from "../content/ordered";
import { icons } from "../icons";

const steps = await ordered("steps");
---

<section class="tint" id="how">
  <div class="wrap">
    <div class="sec-head">
      <h2>From idea to insight in five steps</h2>
    </div>
    <div class="steps">
      {steps.map(({ data }, i) => {
        const Icon = icons[data.icon];
        return (
          <div class="step">
            <div class="node" aria-hidden="true">
              <Icon />
            </div>
            <div class="n">{String(i + 1).padStart(2, "0")}</div>
            <h3>{data.title}</h3>
            <p>{data.body}</p>
          </div>
        );
      })}
    </div>
  </div>
</section>

<style>
  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 12px;
    margin-top: 40px;
  }
  .step {
    --bg: var(--navy-100);
    --ink: var(--navy-700);
    --sub: var(--navy-600);
    --nbg: var(--navy-600);
    --nfg: #fff;
    padding: 22px 20px 24px;
    border-radius: 12px;
    background: var(--bg);
    color: var(--ink);
    transition:
      transform 220ms cubic-bezier(0.2, 0, 0, 1),
      box-shadow 220ms cubic-bezier(0.2, 0, 0, 1);
  }
  .step:nth-child(2) {
    --bg: var(--navy-200);
  }
  .step:nth-child(3) {
    --bg: var(--navy-400);
    --ink: #fff;
    --sub: rgba(255, 255, 255, 0.88);
    --nbg: #fff;
    --nfg: var(--navy-600);
  }
  .step:nth-child(4) {
    --bg: var(--navy-500);
    --ink: #fff;
    --sub: rgba(255, 255, 255, 0.86);
    --nbg: #fff;
    --nfg: var(--navy-600);
  }
  .step:nth-child(5) {
    --bg: var(--navy-600);
    --ink: #fff;
    --sub: rgba(255, 255, 255, 0.84);
    --nbg: var(--gold-500);
    --nfg: var(--navy-900);
  }
  .step .n {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--nbg);
    color: var(--nfg);
    font-size: 12px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 12px;
    transition: transform 220ms cubic-bezier(0.2, 0, 0, 1);
  }
  .step h3 {
    font-size: 14px;
    margin-bottom: 4px;
    color: var(--ink);
  }
  .step p {
    font-size: 12.5px;
    color: var(--sub);
    line-height: 1.5;
  }
  .step:hover {
    transform: translateY(-4px);
    box-shadow: 0 10px 24px -10px rgba(0, 35, 68, 0.35);
  }
  .step:hover .n {
    transform: scale(1.14);
  }
  @media (prefers-reduced-motion: reduce) {
    .step,
    .step .n {
      transition: none;
    }
    .step:hover {
      transform: none;
    }
    .step:hover .n {
      transform: none;
    }
  }
  @media (max-width: 900px) {
    .steps {
      grid-template-columns: 1fr;
    }
  }
  .step h3 {
    font-size: 18px;
  }
  .step p {
    font-size: 16px;
  }
  .step .n {
    font-size: 14px;
  }
  .step:nth-child(1),
  .step:nth-child(2) {
    --ink: #000;
    --sub: #000;
  }
  .steps {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 24px;
    margin-top: 56px;
  }
  .step {
    position: relative;
    background: 0 0;
    border-radius: 0;
    padding: 0;
    border-top: 0;
    color: #000;
    transition: none;
  }
  .step:hover {
    transform: none;
    box-shadow: none;
  }
  .step:nth-child(n) {
    --ink: #000;
    --sub: #000;
  }
  .step .n {
    background: 0 0;
    color: #000;
    width: auto;
    height: auto;
    border-radius: 0;
    justify-content: flex-start;
    font-family: var(--font-mono);
    font-size: 15px;
    font-weight: 500;
    margin-bottom: 10px;
  }
  .step:hover .n {
    transform: none;
  }
  .step h3,
  .step p {
    color: #000;
  }
  .step .node {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--navy-600);
    background: #fff;
    color: var(--navy-600);
    margin-bottom: 20px;
    position: relative;
    z-index: 1;
  }
  .step .node {
    box-shadow:
      0 10px 20px -8px rgba(0, 51, 102, 0.45),
      0 3px 8px rgba(0, 51, 102, 0.18);
  }
  .step .node svg {
    width: 26px;
    height: 26px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.7;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .step:last-child .node {
    background: var(--navy-600);
    color: #fff;
  }
  .step:not(:last-child)::after {
    content: "";
    position: absolute;
    top: 27px;
    left: 68px;
    right: -12px;
    height: 2px;
    background: var(--navy-200);
  }
  @media (max-width: 900px) {
    .step:not(:last-child)::after {
      display: none;
    }
    .steps {
      grid-template-columns: 1fr;
    }
  }
  .step p {
    font-size: 17px;
    line-height: 1.6;
  }
  @media (max-width: 640px) {
    .steps .step {
      text-align: center;
    }
    .step .n {
      justify-content: center;
    }
    .step .node {
      margin-left: auto;
      margin-right: auto;
    }
  }
</style>
