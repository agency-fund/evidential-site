{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "evidential-docs",
  "compatibility_date": "2026-11-17",
  // A static site: Workers Static Assets serves the built dist/, with Nimbus's 404 page. There is no Worker code.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Production: only the docs.evidential.dev custom domain, attached by the first `wrangler deploy` (`task docs:launch`).
  "workers_dev": false,
  "routes": [{ "pattern": "docs.evidential.dev", "custom_domain": true }],
  // Previews go to a separate Worker, evidential-docs-preview (`task docs:deploy:preview` passes --worker-name), so
  // the token CI uses for them can't change production. They never take over routes and are served on
  // <preview-name>-evidential-docs-preview.the-agency-fund.workers.dev, which Cloudflare marks noindex.
  "preview_urls": true,
  // Previews take only what's listed here; the site needs no bindings, variables, or secrets.
  "previews": {},
}
